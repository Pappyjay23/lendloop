# ---------------------------------------------------------------------------
# LendLoop — Next.js environment
# Copy to `.env.local` and fill in. This file is safe to commit; `.env.local` is not.
# ---------------------------------------------------------------------------

# Clerk — https://dashboard.clerk.com → API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk issuer domain, e.g. https://your-app.clerk.accounts.dev
# Public information, not a secret. Used by convex/auth.config.ts.
CLERK_JWT_ISSUER_DOMAIN=

# Convex — written automatically by `npx convex dev`
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOYMENT=

# Optional: route Clerk's post-auth redirects
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ---------------------------------------------------------------------------
# Convex deployment variables — set with `npx convex env set NAME value`
# (listed here for documentation; these are NOT read by Next.js)
#
# ADMIN_EMAILS=pjinadu02@gmail.com
# SITE_URL=http://localhost:3000
# N8N_REQUEST_WEBHOOK_URL=http://localhost:5678/webhook/lendloop/request-event
# OUTBOUND_SECRET=
# INBOUND_SECRET=
# MAIL_FROM=LendLoop <loans@peacejp.dev>
# ---------------------------------------------------------------------------
