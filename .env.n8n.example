# ---------------------------------------------------------------------------
# Docker Compose environment for n8n + Postgres + Mailpit
# Copy to `.env.n8n` and fill in, then run:
#   docker compose --env-file .env.n8n up -d
# Generate each 32-byte secret with:
#   openssl rand -hex 32        (or: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# ---------------------------------------------------------------------------

POSTGRES_PASSWORD=change-me

# 32+ character encryption key for n8n credentials. Generate once and keep it.
N8N_ENCRYPTION_KEY=

# Public URL of this n8n instance. For a local stack behind a tunnel, use the
# tunnel URL (e.g. https://abc.trycloudflare.com/). For n8n Cloud, its own URL.
N8N_WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=UTC

# Convex .convex.site origin (HTTP actions), e.g. https://happy-otter-123.convex.site
LENDLOOP_CONVEX_SITE_URL=

# Signed, shared secrets. Must match the Convex deployment env vars exactly.
# OUTBOUND: Convex -> n8n (n8n verifies)
# INBOUND:  n8n -> Convex (Convex verifies)
LENDLOOP_OUTBOUND_SECRET=
LENDLOOP_INBOUND_SECRET=

# Sender identity. Local Mailpit accepts anything; production uses the Resend
# verified domain (loans@peacejp.dev).
LENDLOOP_MAIL_FROM=LendLoop <loans@peacejp.dev>
LENDLOOP_ALERT_EMAIL=ops@peacejp.dev
